     c.drawString(margin, y, prefix + line)  # Left-aligned for body text\n","            y -= line_spacing\n","\n","    def draw_line():\n","        nonlocal y\n","        c.line(margin, y, width - margin, y)\n","        y -= 10\n","\n","    # Contact Information (Centered)\n","    c.drawCentredString(width / 2, y, data[\"Name\"])  # Center the name\n","    y -= line_spacing\n","    c.drawCentredString(width / 2, y, f\"{data['Email']} • {data['LinkedIn']}\")  # Center email and LinkedIn\n","    y -= line_spacing  # Adjust y for next section\n","    y -= 10  # Extra space after contact block\n","\n","    # Professional Summary\n","    write_text(\"PROFESSIONAL SUMMARY\", True)\n","    draw_line()\n","    summary = f\"Passionate {', '.join(data['Additional Details'])} with expertise in {', '.join(data['Keywords'])} from {data['Education'][-1].split(',')[1].strip()}. Looking to join as a Python developer.\"\n","    write_text(summary)\n","    y -= 20\n","\n","    # Experience (Combining Experience and Projects)\n","    write_text(\"PROFESSIONAL EXPERIENCE\", True)\n","    draw_line()\n","    all_exps = data[\"Experience\"] + [f\"Project: {proj}\" for proj in data[\"Projects\"]]\n","    for exp in sorted(all_exps, key=lambda x: x.split(\",\")[-1] if \",\" in x else \"9999\", reverse=True):  # Sort by year\n","        for kw in data[\"Keywords\"]:\n","            if kw in exp.lower():\n","                exp = exp.replace(kw, f\"{kw} ({kw} skills)\")\n","        write_text(exp, bullet=True)\n","    y -= 20\n","\n","    # Education\n","    write_text(\"EDUCATION\", True)\n","    draw_line()\n","    for edu in data[\"Education\"]:\n","        write_text(edu)\n","    y -= 20\n","\n","    # Expert-Level Skills\n","    write_text(\"EXPERT-LEVEL SKILLS\", True)\n","    draw_line()\n","    write_text(\", \".join(data[\"Technical Skills\"]))\n","    y -= 20\n","\n","    # Additional Information (Extracurricular + Work Sample)\n","    write_text(\"ADDITIONAL INFORMATION\", True)\n","    draw_line()\n","    additional = data[\"Extracurricular\"] + data[\"Work Sample\"]\n","    write_text(\", \".join(additional))\n","\n","    c.save()\n","    return filename\n","\n","# Create and download\n","pdf_file = create_resume_pdf(data)\n","files.download(pdf_file)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":17},"id":"Efm06lyHFhgj","executionInfo":{"status":"ok","timestamp":1744651952277,"user_tz":-330,"elapsed":42,"user":{"displayName":"Murthy Pothula","userId":"00497470338885657132"}},"outputId":"c7ad98c5-6fae-4549-fdfe-0adf06cb3005"},"execution_count":37,"outputs":[{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.Javascript object>"],"application/javascript":["\n","    async function download(id, filename, size) {\n","      if (!google.colab.kernel.accessAllowed) {\n","        return;\n","      }\n","      const div = document.createElement('div');\n","      const label = document.createElement('label');\n","      label.textContent = `Downloading \"${filename}\": `;\n","      div.appendChild(label);\n","      const progress = document.createElement('progress');\n","      progress.max = size;\n","      div.appendChild(progress);\n","      document.body.appendChild(div);\n","\n","      const buffers = [];\n","      let downloaded = 0;\n","\n","      const channel = await google.colab.kernel.comms.open(id);\n","      // Send a message to notify the kernel that we're ready.\n","      channel.send({})\n","\n","      for await (const message of channel.messages) {\n","        // Send a message to notify the kernel that we're ready.\n","        channel.send({})\n","        if (message.buffers) {\n","          for (const buffer of message.buffers) {\n","            buffers.push(buffer);\n","            downloaded += buffer.byteLength;\n","            progress.value = downloaded;\n","          }\n","        }\n","      }\n","      const blob = new Blob(buffers, {type: 'application/binary'});\n","      const a = document.createElement('a');\n","      a.href = window.URL.createObjectURL(blob);\n","      a.download = filename;\n","      div.appendChild(a);\n","      a.click();\n","      div.remove();\n","    }\n","  "]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.Javascript object>"],"application/javascript":["download(\"download_9c49cf41-0ed2-4455-9d38-8af3d67fb36f\", \"resume.pdf\", 2497)"]},"metadata":{}}]},{"cell_type":"code","source":["from IPython.display import display, HTML\n","import pandas as pd\n","\n","# Input Form (Unchanged)\n","#@title Candidate Resume Information\n","name = \"John Doe\" #@param {type:\"string\"}\n","email = \"john.doe@example.com\" #@param {type:\"string\"}\n","phone = \"123-456-7890\" #@param {type:\"string\"}\n","linkedin = \"linkedin.com/in/johndoe\" #@param {type:\"string\"}\n","\n","education = \"BS Computer Science, ABC University, 2022, 3.8 GPA; MS Data Science, XYZ University, 2024\" #@param {type:\"string\"}\n","projects = \"ML Classifier, Built a spam email detector using Python and TensorFlow, 2023; Dashboard, Created sales dashboard with Python and Pandas, 2022\" #@param {type:\"string\"}\n","technical_skills = \"Python, SQL, Pandas, TensorFlow, Java, Git\" #@param {type:\"string\"}\n","experience = \"Data Analyst, XYZ Corp, Analyzed data with Python and SQL, 2022-2024; Intern, ABC Inc, Developed Python scripts, 2021\" #@param {type:\"string\"}\n","certifications = \"Certified Data Scientist, 2023; AWS Cloud Practitioner, 2022\" #@param {type:\"string\"}\n","extracurricular = \"AI Club President, Volunteer Tutor\" #@param {type:\"string\"}\n","work_sample = \"github.com/johndoe, kaggle.com/johndoe\" #@param {type:\"string\"}\n","additional_details = \"Skilled in machine learning\" #@param {type:\"string\"}\n","job_keywords = \"data analysis, machine learning, Python, SQL, TensorFlow\" #@param {type:\"string\"}\n","\n","# Process the Data\n","data = {\n","    \"Name\": name,\n","   